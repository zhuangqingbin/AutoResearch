[
  // ═══ 保送票清单(特别关注·手工强制送到最终)═══
  // 每条 = 一只被保送的票,会被强制走完 L1→L5 全程直通(不占各段名额、不挤他票),即使召回本会漏掉它。
  // 用途:你确信要盯、但漏斗可能筛不出来的票(冷门/刚破位/事件驱动),手工塞进来保证出决策卡。
  //
  // 字段(每条对象):
  //   "code"    —— 6位股票代码,必填(容忍 .SH/.SS 后缀与未补零短码,内部归一)
  //   "note"    —— 保送理由,可选;会印在决策卡上
  //   "expires" —— 失效日 YYYY-MM-DD,可选;缺省 = 加入日 + 10 交易日(防僵尸条目永久占用)
  //
  // 上限 cap=5(超出按文件顺序截断);过期条目自动无视并在报告备注。
  // 空列表(现状)= 无保送,漏斗行为不变。要保送就照下面示例取消注释并改成你的票:
  //
  { "code": "300857", "note": "协创数据 持仓", "expires": "2026-08-25" },
  { "code": "688766", "note": "普冉股份 持仓", "expires": "2026-08-25" },
  { "code": "601869", "note": "长飞光纤 持仓", "expires": "2026-08-25" }
  // { "code": "000001", "note": "破位后企稳观察" }
]
