+
+def test_nonzero_work_exit_reports_the_event_stream_detail(tmp_path, fake_env):
+    body = """\
+        echo '{"type":"error","message":"connect ECONNRESET api.openai.com:443"}'
+        exit 1
+        """
+    ex = _executor(tmp_path, _fake_codex(tmp_path, body))
