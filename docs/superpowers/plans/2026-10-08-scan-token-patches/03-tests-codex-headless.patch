+def test_output_missing_after_exit_zero_is_a_contract_error(tmp_path, fake_env):
+    body = """\
+        echo '{"type":"turn.completed","usage":{"input_tokens":1,"output_tokens":1}}'
+        """
+    ex = _executor(tmp_path, _fake_codex(tmp_path, body))
