{
  // scan-market 唯一参数事实源。优先级:CLI 显式 flag > 本文件 > 代码内建默认;删 key = 内建默认。
  // 每键的块 / 类型 / 缺省 / 分区 / 宿主 / 消费者登记在 autoresearch/contracts/scan_config.py(白名单由它派生,
  //   白名单外或错型 → load 即 raise);新增键三件套 = 注册表 + 真实消费点 + 测试锁。
  // 本文件只写「值 + 作用」;标准九条见 SKILL.md「配置」节;lint:python -m autoresearch.scan.config_standard。
  // 装载:frame --json 校验回显 → Workflow args.config / args.cfg;确定性 CLI 经 user_config.knob() 读同一文件。
  // 例外:保送票清单 pinned.jsonc;L1 校准权重 $CTX/factor_lab/weights.json(仅 calibrated 档);凭证只在 .env。

  // ═══ 分区一 · 漏斗行为(改值会改变选股 / 评级 / BUY) ═══

  // ── pinned · 保送持仓策略(票单在 pinned.jsonc) ── 生效点 scan/user_config.load_pinned · scan/run_bootstrap.prepare_scan_run
  "pinned": {
    "cap": 5,                          // 保送票上限(超出按 pinned.jsonc 顺序截断)
    "ttl_days": 10                     // 条目缺 expires 时的失效窗(交易日)
  },

  // ── signals · 跨阶段谓词阈(落刀 / 健康上涨 / 主力失真 / 质押 / regime / 温度 / 看多行业) ── 生效点 common/scoring.falling_knife_mask · common/scoring.healthy_riser_mask · common/scoring.main_net_distortion_label · common/scoring.pledge_flag_label · common/regime.classify_regime · scan/temperature.temperature_bands · scan/temperature.phase · scan/market.healthy_sectors_cfg · scan/market.sector_healthy_top3
  "signals": {
    "knife_pct_60d": -20.0,            // 落刀:60 日跌幅超此值(L2 帽 / 席位剔刀 / 菜单体检共用)
    "healthy_pct60_range": [0, 40],    // 健康上涨带:lo < 60 日涨幅 < hi(且主力与 cmf 为正)
    "main_flow_distortion": {          // 主力占比失真判型(L3 表列 = L4 简报同一定义)
      "ratio": 0.02,                   // 占比 ≥ 此值才谈微量失真
      "abs_yi": 0.5                    // |绝对净额| < 此值(亿)= 微量
    },
    "pledge_pct": {                    // 股权质押旗
      "high": 40,                      // > 此值 = 爆雷红旗
      "warn": 20                       // > 此值 = 偏高
    },
    "regime_thresholds": {             // regime 分类(站上 MA60 占比)
      "risk_on": 0.55,                 // ≥ 且中位动量 > 0 = trend
      "risk_off": 0.30                 // ≤ 且中位动量 < 0 = risk_off
    },
    "temperature_bands": {             // 温度相位(冰点 / 修复·发酵 / 高潮)
      "cold": 20,                      // < 冰点
      "warm": 40,                      // ≥ 发酵(上行)或退潮
      "hot": 65,                       // ≥ 高潮
      "hysteresis": 3                  // 带内小幅变动不切相位
    },
    "healthy_sectors": {               // 看多行业榜资格(席位 / brief / market_pack 共用)
      "min_members": 8,                // 成分股数 ≥
      "knife_median_min": -20.0,       // 行业 60 日中位涨幅 >
      "mom_center": 10.0,              // 倒 U 动量带中心
      "mom_half": 15.0,                // 倒 U 半宽
      "main_pos_min": 0.5,             // 主力净流入为正的成分占比 ≥(或中位占比 > 0)
      "top_k": 3                       // 榜长度
    }
  },

  // ── l0 · 选集硬门 ── 生效点 scan/frame.build_market_frame · scan/universe.run · scan/run_bootstrap._effective_data_policy
  "l0": {
    "cap_floor_yi": 30,                // 市值地板(亿)
    "include_bj": true,                // 是否纳入北交所
    "source": "tushare",               // 取数源 tushare | em
    "min_amount_yi": 0,                // 日成交额门槛(亿;0 = 关)
    "min_list_days": 0                 // 上市天数门槛(0 = 关)
  },

  // ── funnel · L1 召回(多路 → quota_union → top recall_n) ── 生效点 scan/prelude.run_prelude · scan/universe.run · scan/universe._funnel_overlay · scan/self_review.channel_liveness_lint · scan/universe.configured_recall_mode · scan/recall/channels.heat_weights · scan/recall/channels.heat · scan/frame.panel_cfg · scan/universe.event_lookback_days · scan/universe.lens_top_n
  "funnel": {
    "regime_aware": true,              // L1 权重按当日 regime 选块(仅 weight_profile = calibrated 时有效)
    "recall_n": 1000,                  // L1 召回收口数
    "l2_n": 200,                       // L2 粗排收口数
    "recall_channels": ["composite", "momentum", "reversal", "reversal_confirm", "value", "main_fund", "heat", "growth", "healthy", "lowturn"],   // 启用的召回通道(删本键 = 全部注册通道,含默认停用的 event)
    "channel_quotas": { "value": 312, "momentum": 188, "heat": 112, "healthy": 112, "growth": 112, "main_fund": 150, "reversal_confirm": 150, "lowturn": 120 },   // 各通道配额覆盖(缺的键回落注册表默认)
    "channel_floors": {},              // 各通道保底覆盖(空 = 注册表默认)
    "weight_profile": "preference",    // 权重档 calibrated(读 weights.json)| preference(读 preference_weights)
    "preference_weights": { "momentum": 0.20, "tech": 0.15, "volprice": 0.15, "fund_main": 0.15, "chip": 0.05, "north": 0.05, "growth": 0.05, "value": 0.05, "fund_retail": -0.05, "rz": 0.0 },   // 偏好档十组权重(仅 preference 档读)
    "recall_mode": "multi",            // multi = 多路召回 | composite = 单复合分(对拍 / 回退)
    "heat_weights": {                  // heat 路:成交额 × (1 + 换手分位 × turnover + 量比分位 × vol_ratio)
      "turnover": 0.15,                // 换手分位加成
      "vol_ratio": 0.10                // 量比分位加成
    },
    "panel_lookback_days": 60,         // 量价面板回看交易日(lowturn / vol_ratio_20 的数据)
    "panel_min_days": {                // 面板最少交易日,不足则整列 NaN
      "vol": 10,                       // volprice 组(A 级)
      "turnup": 40                     // 低位转强列(B 级)
    },
    "event_lookback_days": 10,         // event 路事件回看交易日
    "lens_top_n": 50                   // 镜头诊断每镜头 top 数
  },

  // ── l2 · 粗排(确定性分层采样) ── 生效点 scan/universe.run · scan/recall/l2_stratify.knife_cap_exempt_styles · scan/sector_seats.pick_sector_seats
  "l2": {
    "sector_cap": 0.20,                // 任一申万一级占比上限(≥1.0 = 关)
    "knife_cap": true,                 // 落刀帽:merit / 回填 / 非豁免桶按 L0 落刀份额封顶
    "knife_cap_exempt_styles": ["反转", "低位转强"],   // 不受落刀帽的风格桶
    "floors": { "趋势": 20, "健康": 25, "反转": 6, "价值": 12, "成长": 12, "吸筹": 12, "主力": 10, "低位转强": 6, "事件": 0 },   // 风格桶保底(启用集外的桶运行时归零)
    "sector_seats": {                  // 行业席位:当日 healthy top3 行业内取非落刀成员注入 L1
      "enabled": true,                 // 是否出席
      "per_sector": 2,                 // 每行业席数
      "max_sectors": 3                 // 最多几个行业
    }
  },

  // ── sector · 行业 brief 旁路(L2 后并发) ── 生效点 sector/reuse.main · session_agent/domain_ops.scan_sector_prepare · session_agent/domain_ops.collect_sector_snapshot · sector/pack.main · sector/pack.select_briefing_sectors · workflows/scan-market.js · session_agent/dispatch.sector_brief_web_searches · sector/reuse.configured_mom_shift_pp · sector/pack.sector_cfg
  "sector": {
    "reuse_ttl_days": 5,               // brief 复用回看天数
    "max_briefs": 6,                   // 每日行业 brief 上限
    "healthy_top3_extra": true,        // 看多 top3 行业在上限外追加;false = max_briefs 为真上限
    "brief_web_searches": 2,           // 行业 brief 写手可发的有界网查条数(0 = 零新取数;两宿主派发文案同源)
    "reuse_mom_shift_pp": 3.0,         // 行业动量位移超此值不复用 brief
    "red_top_n": 3,                    // brief 来源:红榜行业数
    "l2_conc_top_n": 3,                // brief 来源:L2 集中度行业数
    "leaders_n": 5,                    // 喂 sector-brief 的市值龙头数
    "terrain_max_rows": 40,            // L3 表前地形段行数上限
    "readthrough_max": 4               // 产业链 readthrough 每层项数上限
  },

  // ── calendar · 日历事实(解禁 / 指数调样) ── 生效点 scan/calendar.harvest_calendar · scan/health.index_events_health · scan/relative_buy._index_events_input · scan/report_sections.prepare_report_model · scan/index_events.harvest_index_events · scan/calendar.calendar_cfg · scan/calendar.calendar_flags · scan/calendar.calendar_section · scan/index_events.post_window
  "calendar": {
    "index_rebalance": true,           // 取指数调样公告,写 calendar.csv 第三腿(与 relative_buy.rebalance_gate 同开同关)
    "index_rebalance_flow": false,     // 调样行补 ETF 规模描述字段(多两次 tushare 调用)
    "horizon_days": 35,                // 解禁往前看的自然日
    "unlock_flag": {                   // L4 简报 ⚠ 解禁旗
      "within_days": 30,               // 窗口(自然日)
      "min_ratio_pct": 2.0             // 占流通比门槛(%)
    },
    "section": {                       // summary 📅 日历块
      "window_days": 14,               // 未来几天
      "big_ratio_pct": 5.0             // 大解禁门槛(%)
    },
    "index_post_window": 3             // 调样生效后继续展示的交易日
  },

  // ── sentinel · 哨兵档(全市场健康上涨占比过低时跳过 L3/L4) ── 生效点 scan/menu.sentinel_thresholds
  "sentinel": {
    "auto_below": 0.03,                // 全市场健康上涨占比 < 此值 = 自动哨兵档(跳 L3/L4)
    "consider_below": 0.05             // 此值以下提示「可考虑哨兵」,人拍板
  },

  // ── l3 · 精排(pass1 确定性分诊 + pass2 holistic) ── 生效点 scan/l3/prompt.prepare_l3_table · workflows/scan-market.js · session_agent/dispatch._pass1_target · scan/l3/merge.composite_seat_cfg · scan/l3/merge.composite_seat_exclude_knife · scan/l4/card_count.effective_caps · scan/l3/merge.guards_cfg · scan/l3/merge.merge_l3_finalists_v3 · scan/l3/merge._exclusion_reason · scan/l3/merge.pick_composite_seats · scan/l3/triage.pass1_cfg · scan/l3/triage.triage_l2_for_l3 · scan/l3/prompt.table_cfg · scan/l3/prompt.profile_cfg · scan/l3/prompt.row_profile · scan/l3/prompt.lookback_days · scan/l3/evidence.harvest_l3_evidence · scan/agents/l3_news.harvest_l3_news · scan/agents/l3_catalyst.harvest_catalyst · scan/recall/channels._lowturn_cfg · common/turnup.lowturn_flag
  "l3": {
    "two_pass": true,                  // 两遍法;false = 单遍读全表
    "pass1_target": 40,                // pass1 分诊留给 l3-rank 的行数
    "finalist_min": 4,                 // L3 finalist 区间下限(上限由 l4.max_cards 算出,GATE1 回显)
    "composite_seat": {                // composite 证据席
      "enabled": true,                 // 席位开关
      "m": 1,                          // 强送 finalists 的席位数(计入 l4.max_cards)
      "exclude_knife": true            // 席位剔落刀
    },
    "guards": {                        // finalists 守卫阈(merge_l3_finalists_v3)
      "chase_1d_pct": 9.5,             // 当日涨幅 ≥ 此值剔除(席位共用)
      "sector_cap": 3,                 // 同行业 finalist 上限
      "healthy_quota_frac": 0.0,       // healthy 配额比例(0 = 关)
      "conv_force_in": 75,             // 确信 ≥ 此值强制补入
      "conv_min": 55,                  // 确信 < 此值禁止 finalist
      "qualify_conv": { "backfill": 55, "lane": 65, "lowturn": 55 },   // 回填 / lane 置换 / lowturn 置换的够格线
      "lane_floors": { "trend": 2, "lowturn": 1 }   // lane 保底席数(行业帽剔票不可击穿)
    },
    "pass1": {                         // 确定性分诊(triage_l2_for_l3)
      "resonance_cap": 5,              // 多路共振强留上限
      "resonance_min_channels": 3,     // 命中几路算共振
      "healthy_mandatory": false       // healthy lane 是否全部强留
    },
    "table": {                         // 喂 l3-rank 的紧凑表(l3_table_md)
      "delta": true,                   // 略去「昨判弃且今无变化」的行
      "delta_tol": { "composite": 2.0, "pct_60d": 2.0 },   // 判「有变化」的阈
      "sections": { "dist": true, "reg": true, "cat": true, "sector_terrain": true, "misread": true, "pinned": true, "lane_blocks": true }   // 表内证据列 / 地形段开关
    },
    "profile": {                       // 画像词阈值(row_profile)
      "pct60_high": 40,                // 60 日涨幅 ≥ 此值 = 高位
      "pct60_mid": 10,                 // ≥ 此值 = 中位
      "pct60_low": -10,                // > 此值 = 低位,否则深跌
      "pct1_big": 9.5,                 // 今日大涨
      "near_high": -2,                 // 距 60 日高 ≥ 此值 = 贴顶
      "vol_ratio_big": 2,              // 放量
      "pe_low": 20,                    // PE 低 / 中分界
      "pe_high": 60,                   // PE 中 / 高分界
      "winner_full": 90,               // 获利盘 ≥ 此值 = 满盈利
      "winner_trapped": 25,            // 获利盘 < 此值 = 深套牢
      "rsi_overbought": 80,            // RSI6 ≥ 超买
      "rsi_oversold": 20               // RSI6 ≤ 超卖
    },
    "lookback_days": { "evidence": 10, "news": 10, "catalyst": 10 },   // L3 证据 / 公告情感 / 催化回看交易日
    "lowturn": {                       // 低位转强旗 + pass1 强留(谓词 common/turnup.lowturn_flag,L1 同阈值)
      "enabled": true,                 // 旗列与 pass1 强留开关
      "max_dist_high_60": -15.0,       // 距 60 日高 ≤ 此值(%,负数 = 仍在水下)
      "max_pct_60d": 10.0,             // 60 日涨幅 <
      "min_vol_ratio_20": 1.2,         // 20 日量比 ≥
      "min_pct_5d": 0.0,               // 近 5 日涨幅 >
      "require_above_ma20": true,      // 须站回 MA20
      "require_ma5_gt_ma10": true,     // 须 MA5 > MA10
      "fund": "main_or_cmf",           // 资金转正判据 main | cmf | main_or_cmf
      "knife_pct_60d": -35.0,          // 60 日跌超此值且主力不为正 = 落刀不接
      "pass1_cap": 8                   // pass1 强留上限
    }
  },

  // ── l4 · 决策卡卡数 ── 生效点 scan/l4/card_count.effective_caps · scan/self_review.l4_card_count_lint · scan/l4/prompts.params_block · scan/menu.budget_cfg · scan/menu.l4_budget · scan/menu.zero_buy_streak · scan/l4/rubric.rubric_cfg · scan/l4/rubric.rubric_rating · scan/l4/rubric.force_full_card · scan/dossier.configured_max_days · scan/l4/prompts.configured_echo_lookback · scan/l4/producers.producers_cfg · scan/l4/producers.fetch_pledge · scan/l4/producers.fetch_seats · scan/l4/producers.fetch_consensus · scan/l4/producers.slim_min_bytes · scan/l4_tasks.prepare_slim · scan/l4/prompts.slim_hint · workflows/l4-stock.js · scan/decision_finalize.review_cfg · scan/decision_finalize.review_trigger · scan/decision_finalize._ensemble_flag · session_agent/domain_ops.scan_review_plan · session_agent/workflows/scan.review3_expansion
  "l4": {
    "max_cards": 5,                    // 非 📌 卡上限(含 composite 席位;📌 持仓恒出卡不占额)
    "budget_flags": true,              // finalist 名额再与菜单预算取小(max_cards = 13 时预算档最低 10,旗咬不到)
    "shadow_fields": true,             // 卡上三条影子机读行(兑现机制/入场否决/情景),只记账不进门
    "budget": {                        // 菜单感知 L4 预算(menu.l4_budget;只降不升)
      "base": 30,                      // 预算基准
      "floor": 12,                     // 预算下限
      "flags": { "knife_share_max": 0.60, "knife_rel_min": 0.40, "knife_rel_mult": 2.0, "healthy_min": 2, "risk_off": true, "streak_warn": 3, "streak_heavy": 5, "streak_hard": 7, "streak_lookback": 10 },   // 五面旗阈:落刀占比 / 相对落刀 / 健康数 / 避险市 / 0 买连败
      "tiers": { "one_flag": 0.75, "multi": 0.5, "hard_min": 8, "hard_div": 3 }   // 降档比例:一面旗 / 多面旗 / 长连败硬压
    },
    "rubric": {                        // 评分卡(rubric_rating / force_full_card)
      "rating_bands": { "Buy": 4, "Overweight": 2, "Hold": -1, "Underweight": -3 },   // 六维净分 → 建议评级的下限
      "force_full": { "conviction_min": 70, "channels_min": 4 }   // 强先验票强制满卡:确信 ≥ 且召回路数 ≥
    },
    "brief": {                         // 任务包简报回看窗
      "dossier_days": 10,              // 前科卡回看几个 scan 日
      "echo_lookback_days": 5          // 昨卡回声回看自然日
    },
    "producers": {                     // 卡片输入数据窗(l4/producers)
      "pledge_reuse_days": 7,          // 质押数据复用天数
      "lhb_reuse_days": 7,             // 龙虎榜席位复用天数
      "lhb_window_days": 20,           // 龙虎榜统计窗(自然日)
      "lhb_tail": 15,                  // 龙虎榜取最近几个交易日
      "consensus_window_days": 30,     // 一致预期缓存窗
      "consensus_min_days": 10         // 一致预期最少缓存日,不足不落盘
    },
    "slim": {                          // slim 取数稿
      "min_bytes": 4096                // 合格地板(字节;任务包可信句同源)
    },
    "review": {                        // ≥OW / 持仓卖出双复核(两宿主同读)
      "ow_ratings": ["Buy", "Overweight", "增持", "买入"],   // 触发 ow_review 的评级
      "sell_review_pinned_only": true, // sell_review 只对 📌 持仓
      "max_runs": 3,                   // 复核最多几个 run(2 = 不派裁决票)
      "spread_escalate": 2             // run 间分歧 ≥ 此档数 → 人裁
    }
  },

  // ── l4_intel · 活体情报站 ── 生效点 workflows/l4-stock.js · session_agent/workflows/scan._frozen_intel_enabled · session_agent/domain_ops.scan_l4_prepare · scan/l4/intel_guard.configured_soft_cap · scan/self_review.product_shape_lint · scan/l4/intel_gate.decide · scan/l4/intel_guard.guard_cfg · scan/l4/intel_status.status_cfg · scan/l4/intel_gate.dead_gate_factors
  "l4_intel": {
    "enabled": true,                   // 派活体情报员;false = 卡内网查兜底
    "max_queries": 20,                 // 情报员网查条数软顶(prompt 上限 + 裁稿 + 发布前 lint)
    "skip_when_dead": false,           // 死票不派 intel(尚未接线:开关暂无效果)
    "hard_cap": 30,                    // 自报网查条数硬顶(超顶按时效裁稿,裁无可裁才拒稿)
    "soft_trim_keep": 10,              // 超软顶时按时效裁到保留的事件行数
    "stale_gap_days": 7,               // 事件超此天数且非催化挂 → 净分归零
    "max_attempts": 3,                 // 盲搜首发 + 重试总次数(仅 legacy workflow)
    "resume_max_age_s": 86400,         // 同日续传:稿与 status 不超过此秒数
    "dead_gate": {                     // 死票三线(随 skip_when_dead 接线)
      "main_inflow_max": 0.0,          // 主力绝对净额 < 此值
      "cmf_max": 0.0,                  // cmf_20 < 此值
      "obv_max": 0.0                   // obv_mom_20 < 此值
    }
  },

  // ── relative_buy · 相对 BUY(E6) ── 生效点 scan/relative_buy.configured_relative_buy · scan/relative_buy.configured_rebalance_gate · scan/relative_buy.rule_params · scan/relative_buy.build_decision · scan/relative_buy._hard_gate · scan/relative_buy._raw_faces · scan/relative_buy._faces_table
  "relative_buy": {
    "mode": "active",                  // shadow 只记账 | active 正式出 BUY
    "exclude_pinned": true,            // 📌 持仓不参与当日 BUY
    "pool": "finalists",               // 候选池 finalists | composite(只在证据席里选)
    "tiering": true,                   // 入场门 + A/R 分级(卡面 PROHIBITED 否决)
    "rebalance_gate": true,            // 调样生效前夜的调样票否决(与 calendar.index_rebalance 同开同关)
    "max_buys": 1,                     // 每日 BUY 上限(取排序前 N)
    "liquidity_pctl_floor": 0.10,      // tradable 门:成交额分位下限
    "redflag": {                       // no_redflag 硬门否决集
      "early_stop_reasons": ["基本面恶化", "估值透支", "涨停追高", "数据不足"],   // 早停停因红灯
      "ratings": ["Sell", "Underweight"],   // 卡面评级红灯
      "proposals": ["SELL"]            // 卡面机读提案红灯
    },
    "risk_early_stop_reasons": ["涨停追高", "题材透支", "资金流出", "估值透支", "基本面恶化"],   // 风险面计入的停因
    "scoring": {                       // 四面记分
      "recall_weights": { "n_channels": 0.5, "best_channel": 0.5 },   // 召回强度面:路数分位 / 最强单路分位权重
      "evidence": { "full": 1.0, "early_stop": 0.4, "intel": 0.2, "dossier": 0.2, "price_claim_clean": 0.2 },   // 证据面记分
      "risk_bonus": 1.0,               // 早停风险类停因加的风险分
      "missing_fill": 0.5              // 缺失的面按此分位填
    }
  },

  // ── execution · 执行时钟(运营入场截止 / 过期滞后) ── 生效点 contracts/agent_output.exec_line_thresholds · scan/exec_anchor.entry_cutoff · scan/exec_anchor.expiry_lag_sessions
  "execution": {
    "entry_line": {                    // 决策卡「执行线」两行的阈值(任务包渲染给 l4-card;事后记账 exec_ok 同源)
      "pct_chg_max": 3.0,              // T+1 当日涨幅超此值放弃尾盘入场
      "pos_in_range_max": 0.7          // 收盘位于当日区间的位置 ≥ 此值放弃入场
    },
    "entry_cutoff": "14:45",           // T+1 运营入场截止(人读完报告还要下单;exec_anchor 与 overseas 同用)
    "expiry_lag_sessions": 3           // 报告迟到几个交易日后从「需重新核验」降为「过期」
  },

  // ═══ 分区二 · 运行时(改值只影响成本 / 速度 / 时序 / 通知 / 留存) ═══

  // ── agents · agent 角色 → 档位(注册角色闭集,必须列全) ── 生效点 scan/user_config.validate_user_config · scan/user_config.resolve_agent_bundle
  "agents": {
    "strategist":    { "tier": "critical" },      // 市场研判(macro-brief)
    "sector_brief":  { "tier": "analytical" },    // 行业 brief 写手
    "l3_rank":       { "tier": "critical" },      // L3 精排
    "l3_repair":     { "tier": "repair" },        // L3 产物修复
    "l4_intel":      { "tier": "critical" },      // 活体情报员
    "l4_card":       { "tier": "critical" },      // 决策卡
    "ens_review":    { "tier": "critical" },      // ≥OW / SELL 双复核
    "dossier_init":  { "tier": "critical" },      // 档案首覆
    "stock_full":    { "tier": "critical" },      // 单股 FULL 逻辑角色共用
    "macro_full":    { "tier": "critical" },      // 宏观 FULL
    "sector_full":   { "tier": "critical" },      // 行业 FULL
    "company_intel": { "tier": "critical" },      // A 股公司情报
    "us_intel":      { "tier": "critical" },      // 美股公司情报
    "sector_intel":  { "tier": "critical" },      // 行业情报
    "global_intel":  { "tier": "critical" },      // 全球宏观情报
    "gp_shell":      { "tier": "relay" },         // 命令壳
    "gp_shell_json": { "tier": "relay" }          // 命令壳(JSON 回报)
  },

  // ── agent_engines · 档位 → 各引擎 model / effort ── 生效点 scan/user_config.validate_user_config · scan/user_config._dual_role_specs
  "agent_engines": {
    "claude": {
      "tiers": {
        "critical":   { "model": "claude-opus-5-5", "effort": "max" },     // 判断类
        "analytical": { "model": "claude-opus-5-5", "effort": "xhigh" },   // 描述类
        "repair":     { "model": "claude-opus-5-5", "effort": "medium" },  // 修复类
        "relay":      { "model": "sonnet", "effort": "low" }               // 命令壳
      },
      "role_overrides": {
        "l4_intel":      { "model": "claude-sonnet-5-5" },
        "company_intel": { "model": "claude-sonnet-5-5" },
        "us_intel":      { "model": "claude-sonnet-5-5" },
        "sector_intel":  { "model": "claude-sonnet-5-5" },
        "global_intel":  { "model": "claude-sonnet-5-5" }             // 情报员跑 Sonnet
      }
    },
    "codex": {
      "tiers": {
        "critical":   { "model": "gpt-5.6-sol", "reasoning_effort": "xhigh", "fallback": { "model": "gpt-5.6-terra", "reasoning_effort": "high" } },     // 判断类
        "analytical": { "model": "gpt-5.6-sol", "reasoning_effort": "high", "fallback": { "model": "gpt-5.6-terra", "reasoning_effort": "high" } },      // 描述类
        "repair":     { "model": "gpt-5.6-sol", "reasoning_effort": "medium", "fallback": { "model": "gpt-5.6-terra", "reasoning_effort": "medium" } },  // 修复类
        "relay":      { "model": "gpt-5.6-luna", "reasoning_effort": "low", "fallback": { "model": "gpt-5.6-terra", "reasoning_effort": "low" } }        // 命令壳
      },
      "role_overrides": {
        "l4_intel": { "web_search": "live" },
        "company_intel": { "web_search": "live" },
        "us_intel": { "web_search": "live" },
        "sector_intel": { "web_search": "live" },
        "global_intel": { "web_search": "live" }                  // 情报员必须实时网查
      }
    }
  },

  // ── budgets · 预算告警与并发帽(不拥有截断权) ── 生效点 scan/budget.normalize_budgets · scan/l4_tasks.main · session_agent/mailbox_cli.resolve_max_parallel · session_agent/domain_ops.scan_l4_prepare · scan/budget.evaluate_history · scan/budget._relative_policy
  "budgets": {
    "cache_hit_min": 0.85,             // cache 命中率红线(低于只告警)
    "run_weighted_warn": 7000000,      // 单 run weighted input 红线(超线 RED,不截断)
    "run_weighted_target": 5000000,    // 成熟 cohort 的 weighted input P50 目标
    "stage_cost_usd": {},              // 每阶段成本上限(空 = 不设;如 {"l4-card": 20})
    "stage_wall_seconds": {},          // 每阶段墙钟上限(空 = 不设)
    "concurrency": { "tushare": 4, "l4_stock": 64 },   // 并发帽:tushare = slim 取数槽;l4_stock = L4 派发宽度(session_agent 下 = 全角色并发)
    "min_real_scans": 10,              // 成熟门:不满此数恒 IMMATURE
    "baseline_run": "20260727_2140",   // 成本基线 run
    "maturity": {                      // 成本 / 墙钟成熟门目标
      "phase1": { "cost_reduction": 0.15, "p50": 75, "p90": 100 },   // 一期:成本降幅 / P50 分钟 / P90 分钟
      "phase2": { "cost_reduction": 0.25, "p50": 65, "p90": 90 }     // 二期
    },
    "relative": {                      // 相对预算带:对近期已发布真实扫描中位数的倍数(只告警)
      "window": 10,                    // 基线取最近几场
      "min_runs": 3,                   // 基线不足此数 = NO_BASELINE
      "warn_ratio": 1.5,               // 任一指标达此倍数 = ELEVATED
      "alarm_ratio": 2.0               // 任一指标达此倍数 = SPIKE
    }
  },

  // ── prelude · 前奏步骤 ── 生效点 scan/prelude.configured_skip_steps · scan/prelude.announcement_lookback
  "prelude": {
    "skip_steps": [],                  // 常态跳过的前奏步骤(与 CLI --skip 取并集;名字须在 STEP_NAMES 内)
    "announcement_lookback": 5         // 公告源盲区往回查几个 scan 日
  },

  // ── runner · 无人值守场时钟(scan_run) ── 生效点 scan/scan_run.runner_cfg
  "runner": {
    "window_start": "21:10",           // 定时场最早开跑时刻
    "hard_stop": "01:00",              // 夜间硬截止(次日凌晨)
    "min_runner_minutes": 10,          // 距硬截止不足此分钟数不开
    "run_timeout_minutes": 180,        // runner 墙钟上限
    "live_run_window_min": 90,         // 心跳在此分钟窗内 = 人工会话仍在扫,拒绝开场
    "kill_grace_s": 5.0,               // 停进程组:TERM 后等多久再 KILL
    "subprocess_timeout_s": 1800,      // begin / verify / finalize 子进程超时
    "force_full": false                // 无人值守场是否做人工 override 的全扫
  },

  // ── readiness · 湖就绪探针与预热结算时刻 ── 生效点 scan/readiness.readiness_cfg · scan/prewarm.settle_minutes
  "readiness": {
    "min_rows": 5300,                  // 湖就绪:stk_factor_pro 当日行数下限
    "stable_polls": 2,                 // 行数连续不变几次才算齐
    "interval_s": 300,                 // 轮询间隔(秒)
    "deadline": "22:30",               // 就绪探针截止
    "late_recheck_s": 30,              // 截止已过时补读的间隔(秒)
    "settle_hhmm": "19:15"             // 预热:当日 EOD 视为已结算的最早时刻
  },

  // ── l4_tasks · L4 任务簿:重试 / 卡死 / slim / tushare 槽 ── 生效点 scan/l4_tasks.tasks_cfg
  "l4_tasks": {
    "max_attempts": 2,                 // 任务簿每票最多尝试次数
    "stale_after_s": 3600,             // RUNNING 超过此秒数算卡死可重领
    "slim_retries": 1,                 // slim 取数重试次数
    "slim_workers": 4,                 // slim 批量并发
    "slot_poll_s": 5.0,                // tushare 槽轮询间隔(秒)
    "slot_heartbeat_s": 60             // 等槽时心跳间隔(秒)
  },

  // ── l4_watch · L4 进度播报 ── 生效点 scan/l4_watch.watch_cfg
  "l4_watch": {
    "stale_min": 30,                   // 在飞超过此分钟数提示一次
    "interval_s": 5.0                  // 轮询间隔(秒)
  },


  // ── performance · 调度开关 ── 生效点 workflows/scan-market.js
  "performance": {
    "streaming_l4": true               // L4 流式任务簿;false = 整批 slim GATE3(仅 legacy workflow)
  },

  // ── self_review · 发布前自检(GATE4 判据) ── 生效点 scan/self_review.self_review_cfg · scan/self_review.review · scan/self_review._intel_stale_days
  "self_review": {
    "coverage_min": 0.8,               // 决策卡覆盖率低于此值拦发布
    "composite_floor": 30.0,           // 买单 composite 下限(warn)
    "sector_max": 0.6,                 // 买单行业集中度上限(warn)
    "winner_rate_max": 88,             // 买单获利盘超此值拦发布(需 override)
    "overheat": {                      // 过热买单提醒(warn)
      "pct60": 50,                     // 60 日涨幅 >
      "rsi6": 80                       // 且 RSI6 >
    },
    "liveness_escalate_streak": 3,     // 召回通道连续 0 行几天升红灯
    "citation_min": 6,                 // 满卡带日期引用行数下限
    "intel_stale_days": {              // intel 事件未按时效衰减的判定窗(自然日)
      "v1": 7,                         // v1 稿
      "v2": 31                         // v2 三窗稿(本月)
    }
  },

  // ── report · 报告体积预算 ── 生效点 scan/report_model.report_cfg
  "report": {
    "brief_max_bytes": 3000,           // brief 硬预算(字节)
    "tone_chars": 34,                  // 定调句字符上限
    "summary_target_bytes": 12288,     // summary 目标体积
    "summary_warn_bytes": 16384,       // summary 告警体积
    "appendix_target_bytes": 20480,    // appendix 目标体积
    "appendix_warn_bytes": 24576,      // appendix 告警体积
    "evidence_max_chars": 80           // 候选表「一句依据」截断长度
  },

  // ── retention · 现场留存 ── 生效点 scan/transcript_binder._configured_bind_transcripts · scan/retention.retention_cfg · trace/capsule.stale_after · scan/salvage.salvage_windows · scan/transcript_binder.codex_lookback_days
  "retention": {
    "bind_transcripts": true,          // 把研究 agent 的读 / 搜 / 写绑定进 capsule
    "archive_transcript_agents": ["l3-rank", "l4-card", "l4-intel", "macro-brief", "sector-brief"],   // 归档哪些 role 的 transcript
    "lake_window_days": 70,            // 湖清单回看窗(交易日)
    "capsule_stale_after_min": 5,      // 陈旧 run 自动冻结的心跳静默分钟数
    "salvage_window_min": 20,          // 现场恢复:mtime 归入取证窗口的容差(分钟)
    "salvage_max_hours": 8,            // 现场恢复:终点未知时顶替的最长 run 时长(小时)
    "codex_transcript_lookback_days": 10   // Codex transcript 候选回看天数
  },

  // ── delivery · 无人值守场送达 ── 生效点 scan/delivery.configured_delivery · scan/delivery.delivery_limits
  "delivery": {
    "channel": "none",                 // none | bark | mail | file(凭证只在 .env)
    "file_dir": null,                  // channel = file 时的目标目录
    "bark_body_limit": 3000,           // 推送正文字节上限(超出截断)
    "http_timeout_s": 15.0,            // Bark 请求超时(秒)
    "mail_timeout_s": 60               // 本机 mail 命令超时(秒)
  },

  // ── overseas · 海外事件日历(只做风险可见) ── 生效点 scan/overseas.overseas_cfg
  "overseas": {
    "horizon_days": 14,                // 海外事件往前看的天数
    "rows_summary": 4,                 // summary 显示行数
    "rows_brief": 1,                   // brief 显示行数
    "rows_tripwire": 3                 // 盯梢显示行数
  },

  // ── tripwire · 持仓盯梢 ── 生效点 scan/tripwire_watch.date_lead_days
  "tripwire": {
    "date_lead_days": 3                // 持仓日期线提前几天预警
  },

  // ── session · session_v1 宿主(mailbox / headless) ── 生效点 session_agent/workflows/macro.global_intel_policy · session_agent/config.session_cfg · session_agent/dispatch.build_request · session_agent/mailbox_cli._build_executor · session_agent/executors/headless_codex.HeadlessCodexExecutor.__init__ · session_agent/executors/headless_claude.HeadlessClaudeExecutor.__init__ · session_agent/executors/headless_claude.HeadlessClaudeExecutor.max_turns_for · session_agent/executors/mailbox.wait_request · session_agent/executors/mailbox.MailboxExecutor.__init__ · session_agent/mailbox_cli.add_parsers · session_agent/runner._session_max_attempts
  "session": {
    "global_intel_max_queries": 8,     // 全球情报搜索与原文抓取总额度;仅 session_agent
    "timeouts": {                      // 角色超时(秒,从被领取算起;仅 session_agent)
      "mailbox": { "scan.l4.intel": 1800 },   // mailbox 模式逐 role 覆盖(缺 = executors.base.DEFAULT_TIMEOUTS)
      "headless": {},                  // headless 模式逐 role 覆盖(缺 = HEADLESS_TIMEOUTS)
      "fallback_s": 1800,              // 表外角色的超时
      "codex_open_s": 180              // codex headless 开线程(取 thread id 那一轮)的墙钟,不占角色预算
    },
    "max_turns": {},                   // headless --max-turns 逐 role 覆盖(缺 = MAX_TURNS;仅 session_agent)
    "tier_max_turns": {},              // 表外角色按档位的轮数上限覆盖(缺 = TIER_MAX_TURNS;仅 session_agent)
    "default_max_turns": 60,           // 档位也没有时的轮数上限(仅 session_agent)
    "mailbox": {                       // mailbox 执行器(仅 session_agent)
      "never_taken_factor": 4.0,       // 无人领取:超过角色预算的几倍放弃
      "wait_s": 90.0,                  // mailbox wait 缺省秒数(要 < 宿主 Bash 120 秒)
      "dead_heartbeats": 6,            // 心跳超过几拍未更新判 runner 已死
      "by_reference": true             // 按引用派发:宿主只传指针,全文冻结成授权文件(仅 session_agent)
    },
    "max_attempts": 2,                 // SESSION 任务瞬时错最多尝试次数(仅 session_agent)
    "runner": {                        // runner 循环(仅 session_agent)
      "poll_seconds": 5.0,             // 轮询间隔
      "max_rounds": 20000,             // 轮数上限
      "timeout_multiplier": 1.0,       // 超时倍率
      "fanout_warmup_s": 0             // 同一角色首份派发后其余等几秒(prompt 缓存预热;0 = 关)
    },
    "context": {                       // 研究线程前导瘦身(仅 session_agent)
      "codex_project_doc_max_bytes": 0,          // codex exec 读项目 AGENTS.md 的字节上限;0 = 研究线程不读
      "codex_skills_catalog_budget": 1000,       // codex exec 的 skills 目录预算(token);研究角色不用 skills
      "claude_auto_memory": false      // claude -p 研究线程是否装自动记忆(MEMORY.md);false = 不装
    }
  },

  // ── shells · legacy workflow 中继壳 ── 生效点 workflows/scan-market.js · workflows/l4-stock.js
  "shells": {
    "detached_max_rounds_scan": 40,    // scan-market 长命令有界等待轮数(仅 legacy workflow)
    "detached_max_rounds_l4": 20,      // l4-stock 长命令有界等待轮数(仅 legacy workflow)
    "wait_seconds": 100,               // 每轮前台等待秒数(仅 legacy workflow)
    "misses_lost": 3,                  // 中继壳连续几次无有效回报判 LOST(仅 legacy workflow)
    "trace_calls_per_target": 2,       // 每个业务 agent 的取证壳数(仅 legacy workflow)
    "tail_lines": 15                   // 命令壳回报 stdout 尾行数(仅 legacy workflow)
  },

  // ── dossier · 覆盖档案层 ── 生效点 dossier/config.dossier_cfg · dossier/pool._pool_cap · dossier/pool._recent_scan_days · dossier/pool._refresh_unlocked · dossier/debt_slo · dossier/delta.intel_dossier_gaps · dossier/schema
  "dossier": {
    "pool_cap": 30,                    // 覆盖池上限(LRU 驱逐,📌 不退)
    "recent_days": 20,                 // 入退池观察窗(scan 日)
    "entry_min": 2,                    // 观察窗内真入选几次入池
    "init_per_night": 3,               // 每晚首覆上限
    "max_pending_age_days": 2,         // SLO:待首覆最长天数
    "throughput_window_days": 7,       // SLO:吞吐统计窗
    "intel_gap_max_lines": 2,          // intel 侧档案缺口留痕行数上限
    "summary_cap": 3000,               // 注入摘要 token 硬帽
    "research_body_cap": 12000,        // 研报体素材 token 硬帽
    "stale_days": 90                   // 档案陈旧告警阈值(天)
  },

  // ── observability · 账本读数样本门与 lint 阈(只影响观测) ── 生效点 scan/observability.observability_cfg · scan/behavior_fingerprint.policy
  "observability": {
    "min_ledger_n": 20,                // 结果账本统计最少样本
    "min_session_n": 20,               // 账本视图分段统计最少样本
    "realized_min_n": 20,              // brief 实现收益区间最少样本
    "winner_decile": 0.9,              // 赢家分位
    "swing_readout_min_days": 40,      // 10 日观察席统计最少天数
    "swing_readout_min_clusters": 10,  // 10 日观察席区间最少簇数
    "menu_knife_tolerance": 0.06,      // 不可买归因:菜单落刀容差
    "price_claim_tol_pp": 1.5,         // 价格断言对账容差(百分点)
    "unknown_rate_tolerance": 0.05,    // 价格断言 unknown 率容差
    "round_trip_cost_bp": 12,          // 一买一卖总成本估算(bp):账本与 brief 的扣成本口径
    "exec_floor_pct_1d": -3.0,         // 执行线下沿:T+1 涨幅不高于此(%)单独记一档
    "exec_floor_pos_in_range": 0.1,    // 执行线下沿:T+1 收盘在当日区间位不高于此
    "fingerprint": {                   // 行为指纹相对近期常态的偏离告警(只记账)
      "window": 10,                    // 基线取最近几场
      "min_runs": 3,                   // 基线不足此数 = NO_BASELINE
      "share_delta": 0.25,             // 占比类指标与基线中位相差达此值 = 偏离
      "ratio_warn": 1.5                // 标量与基线中位之比达此倍数(或倒数)= 偏离
    },
    "nan_warn": 0.30                   // 列 NaN 率告警线
  }
}
