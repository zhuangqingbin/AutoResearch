{
  // ═══════════════════════════════════════════════════════════════════════════════
  // scan-market 全流程用户配置 —— **唯一**参数事实源(按漏斗阶段顺序排;支持 // 注释)
  // ═══════════════════════════════════════════════════════════════════════════════
  // 契约(防漂移,详见 SKILL.md「配置单一事实源」节):
  //   优先级:CLI 显式 flag / 显式形参 > 本文件 > 代码内建默认;删 key = 内建默认(parity)。
  //   每个 key 必须标【生效点】=真实消费代码;白名单在 autoresearch/scan/user_config.py,
  //   **白名单外的键 load 即 raise**(写错键名当场炸,不静默失效)。
  //   新增参数三件套:白名单 + 消费点(grep 调用链)+ 测试锁(tests/scan/test_config_knobs.py)。
  //   ⚠️ 改值 ≠ 无害:召回/L3/L4/评级类旋钮属行为变更,先走实验治理(STAGES.md 控制面),
  //   config 是放参数的地方,不是绕过治理的后门。
  //   装载链:frame --json 白名单校验后回显 → Workflow args.config →(L4 每股 args.cfg 透传);
  //   确定性 CLI(universe/prelude/frame/sector.*)在入口经 user_config.knob() 读同一文件兜底。
  //   保送票**清单**在 pinned.jsonc(此处只管 cap/TTL 策略);L1 因子权重在
  //   context_<引擎>/factor_lab/weights.json(factor_lab calibrate 产,不入本文件)。

  // ── 全局 · 预算/并发(观测与派发,不拥有截断权)─────────────────────────────
  // 【生效点】autoresearch/scan/budget.py resolve_budget_policy(post_run 预算告警:超线只写
  //   warning/DEGRADED,不截候选/查询/卡);concurrency 由 scan/l4_tasks.py init 读取形成
  //   L4 派发帽(l4_stock=派发宽度,缺省 64=事实无上限 Wave11-C1;tushare/web_search/web_fetch
  //   为资源帽,tushare 由 prepare_slim K 槽信号量执行)。回滚杆:l4_stock 改 4 = 旧滑窗宽度。
  "budgets": {
    "cache_hit_min": 0.85,             // cache 命中率红线(低于只告警)
    "stage_cost_usd": {},              // 每阶段成本上限(空=不设;如 {"l4-card": 20})
    "stage_wall_seconds": {},          // 每阶段墙钟上限(空=不设)
    "concurrency": { "tushare": 4, "web_search": 4, "web_fetch": 4, "l4_stock": 64 },
    "min_real_scans": 10,              // 成本/墙钟成熟门:不满此数恒 IMMATURE
    "baseline_run": "20260727_2140"    // 成本基线 run(成熟门对照)
  },

  // ── Stage 0 · 保送持仓策略 ─────────────────────────────────────────────────
  // 【生效点】autoresearch/scan/frame.py(load_pinned → 烤进 run_contract;票单读
  //   .claude/skills/scan-market/pinned.jsonc,cap=截断条数、ttl_days=缺 expires 时的失效窗)。
  "pinned": { "cap": 5, "ttl_days": 10 },

  // ── Stage 0 · agent 档位(model/effort;10 role 闭集,**必须列全**,缺一 fail-fast)──
  // 【生效点】user_config.resolve_agent_config(唯一解释点)→ _resolved_agent_config.json →
  //   scan-market.js / l4-stock.js / dossier-init.js 的 AG() + usage_reconcile 逐 role 对账。
  //   effort ∈ low/medium/high/xhigh/max;判断类 role 不写 model 键 = 落 agent def frontmatter
  //   (l3_rank/l4_card=opus、l4_intel=sonnet)。按流程出场顺序排列。
  "agents": {
    "strategist":   { "effort": "max" },     // 市场研判(Stage0 旁路)——07-12 用户拍板 high→max
    "sector_brief": { "effort": "xhigh" },   // 行业 brief(L2 后旁路)——07-12 拍板 sonnet 试点回滚+high→xhigh
    "l3_rank":      { "effort": "max" },     // L3 精排(holistic 比较=判断核心,最高档)
    "l3_repair":    { "effort": "medium" },  // L3 数字自修(可选增益,挂了不阻断)
    "l4_intel":     { "effort": "max" },     // 活体情报员(盲搜六面;model=sonnet 由 agent def 定)
    "l4_card":      { "effort": "max" },     // L4 决策卡(逐只渐进深度 DD)
    "ens_review":   { "effort": "max" },     // ≥OW/SELL 双复核 run2/3——与 l4_card 同档(08-06 review:
                                             // 写 xhigh 会让复核在生产静默降档,parity=max;要降档须显式决策)
    "dossier_init": { "effort": "max" },     // 档案首覆(≤3 只/晚,盘后)
    // 壳类缺省 sonnet·low:08-05 事故——haiku 壳遇长命令转后台会 pkill 生产作业;省钱可显式
    // 改 haiku,但那是你的选择不是缺省。
    "gp_shell":      { "model": "sonnet", "effort": "low" },   // 命令壳(bash/stageGate)
    "gp_shell_json": { "model": "sonnet", "effort": "low" }    // JSON 壳(gate/gpJson/taskGate)
  },

  // ── L0 · 选集硬门 ──────────────────────────────────────────────────────────
  // 【生效点】autoresearch/scan/frame.py build_market_frame(L0 单一代码路径,universe.run 与
  //   frame CLI 共用——market_pack 的 regime/宽度统计与漏斗用同一把地板)+ universe.run
  //   (meta/weights_used 记实际生效值)。CLI:--cap-floor/--exclude-bj/--source 恒优先。
  //   ⚠️ 哲学:每加一条硬门=一块永久盲区(missed_l0≈赢家 9%);收紧属召回行为变更,走实验治理。
  "l0": {
    "cap_floor_yi": 30,        // 市值地板(亿);capfloor20 影子变体在验 20 的反事实,勿在此直接改
    "include_bj": true,        // 纳入北交所(false=剔;92xxxx 历史坑见 pledge 记忆)
    "source": "tushare",       // 取数源:tushare=默认(东财 push2 常被网络封,用户裁定);em=push2
    "min_amount_yi": 0,        // L0 流动性门(日成交额亿 >;0=关=parity)
    "min_list_days": 0         // L0 次新门(上市天数 ≥;0=关=parity)
  },

  // ── L1 · 召回(多路 → quota_union → top recall_n)──────────────────────────
  // 【生效点】universe.run(_funnel_overlay + knob;prelude 生产路与 universe 直跑 CLI 同源)。
  //   regime_aware 另生效于 prelude.run_prelude(生产路缺省 true;universe 直跑 CLI 内建缺省
  //   false,--regime-aware/--no-regime-aware 恒优先)。
  "funnel": {
    "regime_aware": true,      // L1 权重按当日 regime 选块(weights.json regimes;07-02 校准开启)
    "recall_n": 1000,          // L1 召回收口数
    "l2_n": 200,               // L2 粗排收口数
    // 启用的召回通道。整编后 9 路(2026-07-11 channel_audit 13 日累计裁决):剔 accumulation
    // (unique超额T2 −0.21%)、northbound(hk_ratio T+2 IC −0.108)。
    // ⚠️ **删掉本行 = 用全部注册 12 路,会把默认停用·取证中的 event 一并
    // 上线,违反 pr_20260725_001 入场纪律** —— 要动通道先走实验治理。
    // ⚠️ momentum 勘误(2026-08-04):07-11 的「unique +0.75%」已过期且符号翻负(26 日 −1.07%);
    // 切相位后=混合物(回撤侧≈0/上涨侧整区间为负,docs/research/2026-08-04-momentum-phase-
    // conditional-ic.md)——「统一砍 momentum quota」是错处方,相位条件 quota 属 B 类须 registry,
    // 故 quota 维持不动。
    // reversal_confirm 沿革:2026-08-19 摘出(第 9→8 路,名义启用实际恒空 4 周+——起爆硬门
    // vol_ratio_20 从未接入生产 L1 帧,缺列即整段判 False,与旧 reversal 的 A/B 全程空转);
    // **2026-08-21 重开(第 8→9 路)**,reopen 条件已满足且门已修:
    //   ① 数据腿 —— frame._harvest_vol_series 拉 60 日面板 + common/turnup.py 十列(vol_ratio_20/
    //      above_ma20/ma5_gt_ma10/vol_ma*_prev…)入 keep 白名单,L1 帧真有这些列了;
    //   ② 门修法 —— ③ 起爆硬门由 ma_bull(MA5>MA10>MA20>MA60 全多头)改为 above_ma20 ∧ ma5_gt_ma10:
    //      60 日跌 ≥25% 的票起爆当日 MA20 不可能在 MA60 上方,旧代理与①前置低位**定义互斥**,
    //      只接列不改门通道仍会近空(design 2026-08-21 §2.3);② 缩量改看 D−1 截止、RSI 上限 50→85。
    // 与旧 reversal **两路同时活体 A/B**:channel_ledger 按 lane 分行,≥10 扫描日后人批裁决去留
    // (判据见 STAGES.md「开放线头」)。self_review「通道活性」探针盯它 0 行,防同族复发。
    // lowturn(2026-08-22 加,第 9→10 路):低位转强画像的**生产者**。2026-08-21 首跑实测该
    // 画像全帧 120 只亮旗、L1 剩 17、**L2 恰 0** —— L3 侧整套(旗列/pass1 强留/守卫⑥/硬约束 G)
    // 是「没有生产者的消费者」。门 = common/turnup.lowturn_mask(与 L3 旗同谓词同阈值,阈值在
    // 下面 l3.lowturn 块),排序 = reversal_confirm_score。**证据边界**:决策尺 −0.24pp
    // (t=−6.36)与现任 healthy 同负,正超额在 5~10 日尺;接生产者的理由是「不比现任差 + 打开
    // 候选池形状」,不是「隔夜能赚」。回滚 = 从本行摘掉 "lowturn"(L2『低位转强』桶 floor 会
    // 随之运行时归零,逐字 parity)。design 2026-08-22-funnel-shape-after-lowturn-first-run。
    "recall_channels": ["composite", "momentum", "reversal", "reversal_confirm", "value", "main_fund", "heat", "growth", "healthy", "lowturn"],
    // 各路配额覆盖(channel_ledger advisory 档,36 日版累计裁决 2026-08-19 拍板,取代 2026-07-11
    // 的 18 日版:value 250→312(57.6%胜率/+0.9%最优,加码)、momentum 250→188、heat 150→112、
    // healthy 150→112、growth 150→112(三路 unique 超额持续为负,减码);main_fund 保持 150。
    // 六键全写(逐一核对:六个目标值均不等于各路 @channel 注册表默认 momentum250/growth150/
    // value200/main_fund200/healthy150/heat200,任一键缺省都会回落注册表默认而非维持原覆盖值,
    // 故不可只写变动键)。accumulation 120→90 未随本次拍板落地——该路已于 2026-07-11 退役出
    // recall_channels(见下方 recall_channels 键),调 quota 无生效点,是幽灵行。
    // 删本行 = 注册表默认 quota。floor 覆盖同名 "channel_floors":{}(未用)。
    "channel_quotas": { "value": 312, "momentum": 188, "heat": 112, "healthy": 112, "growth": 112, "main_fund": 150,
                        "reversal_confirm": 150,    // 2026-08-21 重开:中档起步(design R6)
                        "lowturn": 120 }            // 2026-08-22 新路:与注册默认同值,写明防「缺键回落注册表默认」
  },

  // ── L2 · 粗排(确定性分层采样,不预测)────────────────────────────────────
  // 【生效点】universe.run → recall/l2_stratify.select_l2。风格桶 floors 明细(趋势20/健康15/…)
  //   =行为归属,留在 l2_stratify.DEFAULT_FLOORS,想调先立实验;此处只放行业集中度帽。
  "l2": {
    "sector_cap": 0.20         // 任一申万一级 ≤ 20%(=40/200);≥1.0=关
  },

  // ── 旁路 · 行业 brief(L2 后并发)──────────────────────────────────────────
  // 【生效点】sector/reuse.py main(--ttl 恒优先)/ sector/pack.py main(--k 恒优先)。
  "sector": {
    "reuse_ttl_days": 5,       // brief TTL 复用回看天数(♻️ 复用判据之一)
    "max_briefs": 6            // 每日行业 brief 上限 K(红榜top3 ∪ L2集中度top3 ∪ watchlist 行业)
  },

  // ── L3 · 精排(两遍法:pass1 确定性分诊 + pass2 holistic 深比较)────────────
  // 【生效点】scan/l3/prompt.py prepare_l3_table(two_pass/pass1_target)、
  //   scan/l3/merge.py write_finalists(finalist_max,cap=min(finalist_max, 当日 l4_budget))。
  //   本块是**回滚杆**非 opt-in:two_pass 改 false / 删块 = 回「单遍读全表」旧行为。
  "l3": {
    "two_pass": true,
    "pass1_target": 40,        // 60→40(2026-07-18 线A:影子回放 20 日 mandatory 0 漏、delta 无赢家
                               // 富集);回滚=改回 60 或 two_pass=false;被切的落影子 _l3_pass1_cut.csv
    "finalist_max": 10,        // finalist tier 上限
    // ── composite 证据席(2026-08-26 §3 路A · 守卫⑨)────────────────────────────
    // 【生效点】scan/l3/merge.composite_seat_cfg → ① write_finalists 的
    //   inject_composite_seats(把当日 L2 菜单 composite 最高的 m 只强制送进 finalists,
    //   guard=composite_seat / lane=composite,不占 finalist 名额、不受 lt55/cap 约束)
    //   ② scan/l3/prompt.prepare_l3_table → triage 的 ①b 强留(让 l3-rank 真判到它们 ——
    //   pass1 切了它们,finalists 里就只剩空 thesis 行,pinned 当年踩过这个坑)。
    // 剔除:📌 保送 / ST·退 / 当日涨幅 ≥9.5%(追高在隔夜尺四年逐年为负)。
    // ⚖️ 证据与边界同 relative_buy.pool 那段(两键是**同一个裁定**的产物,同批改)。
    // 回滚杆 = "enabled": false(一行,逐字 parity);m 每加 1 ≈ +1 张卡 ≈ +$1.5/日。
    "composite_seat": { "enabled": true, "m": 3 },
    // ── 低位转强第三画像(2026-08-21 低位转强波;design §6.1)────────────────────
    // 【生效点】scan/l3/prompt.py prepare_l3_table → l3_table_md(lowturn_flag, lowturn_cfg)
    //   (表内 lowturn 旗列 + 图例)+ scan/l3/triage.py triage_l2_for_l3(lowturn_cap, lowturn_cfg)
    //   (pass1 强留 ≤pass1_cap)。谓词真身 = common/turnup.lowturn_flag(单一事实源,L1/研究/L3 共用)。
    //   `enabled: false` 或删本块 = **逐字 parity**(旗列与 pass1 强留同关;merge 守卫⑥在无
    //   lowturn lane 时天然无操作)——这就是本特性的回滚杆,改一行即可。
    // ⚖️ **上线理由与证据边界(必须连读)**:Gate 0 132 成型日实测,本画像在**决策尺**
    //   `gap_c1_o2` 的相对超额 **−0.24pp(t=−6.36)= 显著为负**;之所以仍上线,是因为**现任
    //   healthy 画像同样显著为负**(−0.17pp,t=−5.74)且量级相当 —— 理由是「不比现任差 +
    //   打开候选池形状」,**不是**「隔夜能赚」。它在周级尺 fwd_5/fwd_10 才翻正且显著
    //   (+0.63 / +0.99pp),即兑现窗口 5~10 日 ≠ 隔夜。读数全文:
    //   docs/research/2026-08-21-lowturn-precheck.md。≥10 扫描日后按 l3_audit/lane 账裁决去留。
    "lowturn": {
      "enabled": true,
      "max_dist_high_60": -15.0,  // 低位:距 60 日高 ≥15%(仍在水下)
      "max_pct_60d": 10.0,        //   且 60 日涨幅 <10(没涨回去)
      "min_vol_ratio_20": 1.2,    // 放量(通道硬门 1.5 的放宽档;L3 还有 agent 复核)
      "min_pct_5d": 0.0,          // 近 5 日为正(转强)
      "require_above_ma20": true, // 站回 MA20
      "require_ma5_gt_ma10": true,// 短均线拐头
      "fund": "main_or_cmf",      // 主力净额>0 或 cmf_20>0;可选 main | cmf
      "knife_pct_60d": -35.0,     // 落刀:60 日跌超此值且主力不为正 → 不接
      "pass1_cap": 8              // pass1 强留上限(保护 40 席预算)
    }
  },

  // ── L4 · 活体情报站(sonnet 盲搜 ∥ slim 预取)──────────────────────────────
  // 【生效点】.claude/workflows/l4-stock.js(intelOn/maxQ;**缺块=intel 关**)+
  //   scan/l4/intel_status.py + self_review 超查探针。真硬顶 hard_cap=30 在
  //   scan/l4/intel_guard.py(超顶稿件 .rejected 弃用,只拒稿不拒票)=代码常量不入 config。
  "l4_intel": {
    "enabled": true,           // 2026-07-12 开启(P1 波验收过);false=干净回滚(卡内网查兜底)
    "max_queries": 20          // 15→20(Wave8 W8-13):对齐实测中位,让 warn 重新变信号
  },

  // ── L4 · 调度性能(只改调度/上下文布局,**不拥有评级**)─────────────────────
  // 【生效点】.claude/workflows/scan-market.js(streamingL4 分支:任务簿流式 vs 旧批量 GATE3)。
  "performance": {
    "streaming_l4": true       // false=回滚到整批 slim GATE3
  },

  // ── 收尾 · 相对 BUY(E6)──【生效点:scan/post_run.publish_run_observation → relative_buy.write_decision/verify_decision】
  // 2026-08-19 用户裁决表(docs/specs/2026-08-18-e6-activation-learning-slimdown-design.md §6)
  // A1/A2 一次性拍板:下面三键是**同一个裁定**的产物,同一 commit 落地,不得分次改。
  // mode: shadow=影子只记账;active=正式接管 BUY。**A1=GO,本次已翻 active**(翻回 shadow
  //   即回滚)。【消费侧生效点(task-2.4)】relative_buy.is_active() → scan/report_sections
  //   (组合视角/仓位 overlay 改 managed 占位+收尾注入)· scan/health.count_buys(改读决策
  //   文件)· scan/brief(③ BUY 结论区)。
  // exclude_pinned: 📌 持仓是否不参与当日 BUY 选择(保送不算判例)。**A2=是,本次已翻
  //   true** —— BUY 只从非📌合格候选取 rank1;📌 持仓不再抢当日 BUY,走各自的 pinned
  //   复核路(08-18 影子 BUY 688766 普冉本身就是📌,正是这条裁定要堵住的形状)。
  // activate_date: 保留键(YYYY-MM-DD 或 null)。原生效点 learning/legacy_freeze 已随
  //   2026-08-21「整个 learning 层退役」裁定删除,本键现无消费点,仅作 E6 转正日的记录。
  // pool(2026-08-26 §3 路A · A1/A3):BUY 候选池来源。
  //   "finalists" = v2 候选池(判断层 finalist 全体);
  //   "composite" = v3 证据席(L3 守卫⑨ 的 composite 席位),排序改按 composite 分。
  // 【生效点】relative_buy.configured_pool() → post_run.publish_run_observation →
  //   build_decision(pool=...);席位真身 = scan/l3/merge.pick_composite_seats。
  // ⚖️ **上线理由与证据边界(必须连读)**:隔夜主尺上 L3·finalist 一族 40 日相对超额
  //   **−0.27pp(t=−3.94)显著为负**,而全表唯一正证据是确定性 composite(+0.14pp,
  //   t=3.05;L2 菜单内 top20/top50 +0.14/+0.17,t 1.96/2.78,42 个扫描日)。所以把 BUY
  //   的所有权从判断层搬到证据层,判断层改做它被证明会做的事(拒绝)。
  //   **期望 ≈ 一次 A 股往返成本量级,不承诺隔夜赚钱**;20 个结果日后按 `_ledger/
  //   recommendations.csv` 的读数裁去留。读数全文:docs/specs/2026-08-26-scene-retention-
  //   and-buy-owner-design.md §1.5/§1.7。
  // 回滚杆 = 本键改回 "finalists"(**只回滚候选池与排序**;A2 的 UW/SELL 硬门对两个池都
  //   生效,要连它一起回滚得改 relative_buy.py 的两个 frozenset,那是显式代码改动)。
  "relative_buy": { "mode": "active", "exclude_pinned": true, "activate_date": "2026-08-19",
                    "pool": "composite" }
}
