{
  // ═══ scan-market 全流程用户配置(直接生效;支持 // 注释)═══
  // 优先级:CLI 显式 flag > 本文件 > 代码内建默认。删掉某 key = 用其默认(=无此文件时的 parity 行为)。

  // ── 各 stage 的 AI agent 模型/effort ──(覆盖 .claude/agents/*.md frontmatter 默认;经 workflow 生效)
  // effort ∈ low/medium/high/xhigh/max;省略某 stage 或 model 字段 = 用其默认。
  "agents": {
    "strategist":   { "effort": "max" },     // 市场研判(macro lite 档,Stage 0)——07-12 用户拍板 high→max
    "sector_brief": { "effort": "xhigh" },   // 行业 brief 写手——07-12 用户拍板:sonnet 下沉试点回滚(删 model 键 → 回 opus)+ effort high→xhigh
    "l3_rank":      { "effort": "max" },     // L3 精排(200只 holistic 比较=判断核心,给最高 effort)
    "l4_intel":     { "effort": "max" },     // 活体情报员(盲搜六面,sonnet 由 agent 定义默认)
    "l4_card":      { "effort": "max" },     // L4 决策卡(逐只渐进深度 DD)
    // T+1 快环(t1-review.js,fb_20260717_001):2 agent = 合诊 + 综合(2026-07-17 用户裁定
    // 勿每票 fan-out——真选 ≤13 只一个 context 装得下,且跨票模式合诊才看得见)。
    // 装载:scan-retro 编排时 `python -m autoresearch.scan.user_config` 读本文件随 args.cfg 传入
    // (合诊 agent 自己跑 build CLI,没法从 pack 拿配置);综合官另有 pack.agents_cfg 兜底。
    "t1_diag":      { "effort": "high" },    // 合诊(≤13 卡对比诊断;model 缺省=继承会话,要省钱可加 "model":"sonnet")
    "t1_synth":     { "effort": "high" }     // 综合官(model 缺省 = 继承会话模型)
  },

  // ── L3 两遍法:pass1 确定性分诊 200→~60 + pass2(l3-rank)深比较出 finalist tier ──
  // (design: 2026-07-12-l3-merge-plan.md;用户裁定即新基线,下列值 = 本波后默认行为,
  // 本 key 是回滚杆而非 opt-in——删掉本块或把 two_pass 改 false 都退回"L3 单遍读全表"旧行为)。
  "l3": {
    "two_pass": true,        // false = 回滚:prepare_l3_table 现行为逐字节不变(不 triage/不切表/不读本块)
    "pass1_target": 40,      // pass1 分诊后喂 pass2(l3-rank)的行数(全入规则命中多时可能略多于此数)
                             // 60→40(2026-07-18 线A):影子回放 20 日 mandatory 0漏;two-pass 时代(07-10起)6日
                             // 仅丢 1 个非赢家 finalist(07-13 000999,target=50 也保不住);delta 20 行赢家率 8.9%
                             // vs 本就被切的 140 行 7.6%=无富集(<1se)。回滚:改回 60 或 two_pass=false。
                             // 前向守卫:retro.pass1_cut_winners 日常盯 cut 吃赢家。读数:scratchpad pass1_shadow_results_v2
    "finalist_max": 10       // finalist tier 上限(merge v3 已接线消费——cap=min(此值,l4_budget))
  },

  // ── L4 活体情报站 ──(sonnet·max 盲搜情报员 ∥ slim 预取;卡侧缺文件自动回退卡内网查)
  // ✅ 2026-07-12 开启:P1 波真跑验收已过(07-10 实跑 38 agent / 0 error / 4 GATE 全绿)。
  // 首跑冒烟三查(设计稿 §6,跑完必看):① WebSearch 并发限频(11–30 并发 searcher 会不会被限)
  //   ② 中文源可达率 ③ intel 空稿率。代价:每天多几百次网查、L4 段墙钟 ~14m → ~30m+。
  // 裁决:单变量 A/B,账本 ≥10–20 日再定去留(enabled 改回 false 即干净回滚)。
  "l4_intel": { "enabled": true, "max_queries": 15 },   // 每票盲搜查询上限(首跑实测>8m 再拧,spec §P4③)

  // ── L1 召回漏斗 ──(recall_channels/channel_quotas 经 scan/cli.py → universe.recall_select 生效)
  "funnel": {
    // 启用的召回通道。整编后 9 路(2026-07-11 channel_audit 13日累计裁决):
    //   剔 accumulation(unique超额T2 −0.21%=唯一实数据负路)、northbound(hk_ratio T+2 IC −0.108);
    //   保 momentum(unique +0.75% 为正,单日 −1.35% 是噪声);reversal_confirm 与旧 reversal 并跑 A/B(≥10日再裁)。
    //   删掉本行 = 用全部注册通道(11路)。
    "recall_channels": ["composite", "momentum", "reversal_confirm", "reversal", "value", "main_fund", "heat", "growth", "healthy"],
    // 各路配额覆盖(Task 8 起 recall_select 真消费,build/quota_union 都吃覆盖后的 effective spec)。
    // heat 200→150:pr_20260711_003 提案 200→100(unique超额T2 全表最弱正值+与 momentum Jaccard
    //   0.27 最高重叠),本 task 拍板取 advisory 档 150、非提案的 100(折中,floor 不动)。
    // value 200→250、main_fund 200→150:同一波 channel_audit 累计账本的 advisory 结论,随本 task
    //   一并应用(proposals.jsonl 无独立 pr_id,归入本 task 的整编批次)。
    // 删掉本行 = 用 CHANNEL_DEFAULTS(注册表默认 quota)。
    "channel_quotas": { "value": 250, "heat": 150, "main_fund": 150 }
    // "channel_floors":  {}                 // 各路保底覆盖 —— 同一形参已接线,本波无需覆盖,维持默认
  },

  // ── 基率收缩估计(shrinkage)──(design: 2026-07-12-selflearning-optimization-brainstorm.md §4 P0-3)
  // 四消费点(l4_card 🔁基率/cross_calib 翻案率/buy_ledger 📐目标校准/gate_ledger 左尾率)注入锚
  // 从"n<10 二值禁注"改"p̂=(n·p_桶+k·p_全局)/(n+k) 收缩值 + ⚠标记",n<3 仍绝对禁注不受本开关影响。
  // shrink=true·shrink_k=15 = 新基线(本块是回滚杆:shrink 改 false 或删本块 = 退回各点原始 raw 计算)。
  "learning": { "shrink": true, "shrink_k": 15 }

  // ── 以下 key 白名单已认但消费方尚未接线(预留,写了也暂不生效)──
